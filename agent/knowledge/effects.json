    {
      "id": "filter_sweep",
      "name": "Filter sweep",
      "aliases": [
        "cutoff sweep",
        "DJ filter",
        "low-pass build",
        "high-pass out"
      ],
      "family": "spectral",
      "cue": "Tone gets brighter or darker while timing is unchanged.",
      "mechanism": "Low-pass or high-pass filter whose cutoff is automated.",
      "control": "ramp-exponential",
      "time_scale": "phrase",
      "energy": [
        "accumulate",
        "release",
        "withhold"
      ],
      "params": {
        "cutoff": "~100 Hz to 18 kHz",
        "resonance": "low to moderate; peaks get loud",
        "span": "1-16 bars"
      },
      "distinguish_from": [
        {
          "id": "phaser",
          "how": "one moving cutoff, not many moving notches"
        }
      ],
      "mistakes": [
        "Starting the sweep too early empties a long build.",
        "High resonance makes huge peaks."
      ],
      "build": {
        "method": "devices",
        "placement": "insert",
        "devices": [
          {
            "name": "Auto Filter",
            "params": {
              "Filter Type": "Low-pass",
              "Resonance": 20,
              "Frequency": 300
            }
          }
        ],
        "automation": [
          {
            "device": "Auto Filter",
            "parameter": "Frequency",
            "curve": "exponential",
            "points": [
              {
                "at": 0,
                "value": 300
              },
              {
                "at": 1,
                "value": 18000
              }
            ]
          }
        ]
      },
      "availability": "standard",
      "references": [
        {
          "track": "Daft Punk - Da Funk",
          "where": "~0:00-0:40",
          "evidence": "A"
        },
        {
          "track": "deadmau5 - Strobe",
          "where": "~5:00-6:30",
          "evidence": "A"
        }
      ]
