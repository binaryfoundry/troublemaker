        "accumulate",
        "signal"
      ],
      "params": {
        "rate": "~2-40 Hz free, or 1/4 to 1/64 synced",
        "gate": "10-70% of each interval",
        "span": "0.5-4 bars"
      },
      "distinguish_from": [
        {
          "id": "tape_stop",
          "how": "pitch of each hit stays put; only spacing changes"
        },
        {
          "id": "retrigger_deceleration",
          "how": "intervals shrink rather than grow"
        }
      ],
      "mistakes": [
        "A linear rate ramp spends most of its time at one end; use a curved law.",
        "Long note tails blur individual ticks."
      ],
      "build": {
        "method": "midi",
        "generator": "retriggerRamp",
        "args": {
          "direction": "accelerate",
