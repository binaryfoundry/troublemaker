      "motif_notes": [3, 5],
      "harmony_devices": ["add9", "sus2", "sus4", "open fifths", "octaves", "fourths", "major/minor ambiguity", "modal harmony", "slow bass-note changes beneath repeated upper notes", "gradual reharmonisation of a static motif"],
      "harmonic_patience": "Avoid constant chord changes; a section gains power from harmonic patience.",
      "groove_layers": ["fundamental pulse", "body", "irregular organic hits", "high-frequency motion", "ghost detail", "distorted rhythmic atmosphere"],
      "orbiting_percussion": { "main_steps": 16, "loop_steps": [15, 12, 7, 10], "note": "The exact lengths are not sacred; layers should only fully realign after a long period." },
      "modulation_cycle_bars": { "filter": 4, "pan": 5, "texture_gain": 7, "delay_feedback": 3 },
      "microtiming": "A few ms of push/pull on organic layers; the kick and essential low end stay stable.",
      "kick_chain": ["EQ Eight", "Saturator", "Drum Buss", "Utility"],
      "bass_chain": ["instrument", "Auto Filter", "Saturator", "EQ Eight", "Compressor", "Utility"],
      "bass_principle": "The bass is a musical event: it may glide, bend, distort, change pulse rate, shift octave, disappear for long periods and return transformed. Keep the deepest component clean; let character live higher up.",
      "states": ["Orientation", "Hypnosis", "Pressure", "Destabilisation", "Collapse", "Release", "Transcendence", "Integration"],
      "arc": ["beauty", "repetition", "subtle instability", "rhythmic pressure", "distortion", "saturation / chaos", "rupture", "clarity"],
      "width_trajectory": { "intro": "narrow", "development": "moderate", "build": "wider", "climax": "extremely wide upper layers", "release": "sudden narrow focus", "resolution": "natural open stereo" },
