        "target": "The listener feels the harmony immediately but cannot say why it feels bittersweet."
      },
      "bass_motion": ["rising scale motion under sustained harmony", "inverted chords", "root -> second -> third movement", "pedal note beneath changing upper harmony", "bass arriving on the chord root after an anticipatory passing note"],
      "bass_rhythm": ["offbeat notes", "syncopated 1/8 movement", "held note followed by a short answer", "pickup notes before the next chord", "one octave jump at phrase boundaries", "a repeated rhythm with changing pitches", "sparse note density with strong groove"],
