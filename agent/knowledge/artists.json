      "motif_notes": [3, 6],
      "kick_bass": ["Treat kick and bass as one system: make the combined low end huge, not each part.", "The kick tail must not fill the gap before the next bass event: long bass, shorter kick; long subby kick, shorter bass.", "Sidechain with enough ducking for unmistakable separation, then back off until the pump is not cartoonish.", "A ghost sidechain trigger can keep the pump through transitions where the kick stops - deliberately, not by habit."],
      "returns": ["A short room", "B main hall", "C long atmosphere", "D tempo delay", "E parallel character"],
      "humanise_ms": [2, 10],
      "humanise_never_ms": 40,
      "mix_order": ["balance", "kick/bass relationship", "vocal or lead focus", "midrange separation", "drum clarity", "depth", "stereo field", "automation", "bus processing", "loudness"],
      "tests": {
        "sixteen_bar": ["what entered?", "what left?", "what changed?", "what became brighter or darker?", "what increased tension?", "what released tension?", "what is the listener waiting for?"],
        "eight_bar_micro": ["percussion fill", "bass pickup", "chord inversion", "vocal fragment", "reverb throw", "kick dropout", "hat opening", "arp change", "filter motion"],
        "drop": ["What was removed immediately before the drop?", "What low-frequency information returns?", "Which single element is the emotional payoff?", "Which layers are held back until bar 5 or 9?", "Is the kick/bass impact obvious at low monitoring volume?"],
        "breakdown": ["Would the breakdown still work with only chord/pad, one motif and one vocal or texture?"]
