    "tinlicker": {
      "source": "TINLICKER.md",
      "prompt": "tinlicker",
      "style": "tinlicker",
      "motto": "Write a strong song first. Then make the production reveal it gradually.",
      "tempo": { "range": [122, 126], "default": 124 },
      "hierarchy": ["emotional chord movement", "bass movement", "kick/bass groove", "primary melodic motif", "arrangement trajectory", "vocal or human focal point", "atmospheric depth", "percussion character", "detailed sound design", "mastering loudness"],
