        "anjunadeep wallpaper": { "symptoms": ["pretty pad", "soft kick", "anonymous bass", "lots of reverb", "no hook"], "fix": ["stronger bass movement", "more defined motif", "more confident kick", "shorter foreground sounds", "more arrangement contrast"] },
        "trance creep": { "symptoms": ["supersaw chords", "excessive uplift", "snare roll", "huge riser", "full-spectrum drop"], "fix": ["reduce unison", "shorten envelopes", "darken top end", "bass groove instead of wall-of-sound", "preserve intimacy"] },
        "tech-house creep": { "symptoms": ["vocal gimmick", "bass dominates harmony", "minimal emotional development", "dry percussion loop carries the track"], "fix": ["strengthen chords", "introduce an emotional motif", "long-range automation", "use atmosphere"] },
        "muddy emotional mix": { "symptoms": ["every instrument has long reverb", "pad occupies 150-800 Hz", "bass tail overlaps kick", "vocal lacks foreground position"], "fix": ["shorten sources", "high-pass/shape effects", "shared reverbs", "dry focal points", "simplify layers"] }
      },
      "decision_rules": {
