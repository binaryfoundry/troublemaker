        "rhythm": ["Is there more internal motion than a single grid loop?", "Does the groove feel physical?"],
        "harmony": ["Is the emotional idea clear?", "Is the harmony patient enough?"],
        "texture": ["Are clean and damaged sound both present?", "Is the damage purposeful?"],
        "space": ["Are there distinct depth planes?", "Does width evolve?", "Are some important elements still intimate?"],
        "arrangement": ["Is there a journey?", "Does each major section have a reason to arrive?", "Do transitions grow from existing material?"],
        "contrast": ["Is there comfort and discomfort?", "Is there restraint before intensity?", "Is there release after pressure?"],
        "originality": ["Does the track sound like an original work rather than a recreation of a specific Jon Hopkins record?"]
      },
      "diagnostics": {
