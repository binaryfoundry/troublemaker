        "flat": ["no long-range automation", "everything at the same width", "constant reverb amount", "no density changes", "no dynamic contrast", "bass never leaves", "distortion never leaves", "no silence or negative space"],
        "techno but not hopkins": ["more emotional harmony", "more transformed acoustic material", "more environmental detail", "longer transition logic", "more resampled intermediate states", "subtler internal polyrhythm", "greater contrast between intimacy and violence"],
        "ambient but not hopkins": ["clearer pulse", "stronger physical low end", "hidden rhythmic cycles", "sharper contrast", "moments of abrasive processing", "stronger narrative arc", "transitions caused by existing material"]
