      "improvement_priority": ["arrangement", "source sound", "resampling", "rhythm", "transition design", "automation", "mix cleanup", "mastering"],
      "anti_patterns": ["sidechained supersaws", "random glitch plugins", "generic melodic techno", "endless arpeggiators", "giant reverb on everything", "constant distortion", "a four-on-the-floor kick plus pretty pad", "preset granular textures", "cinematic risers every 16 bars", "excessive mastering loudness", "lifeless quantisation", "copying the arrangement of Open Eye Signal", "copying the harmony of Emerald Rush"],
