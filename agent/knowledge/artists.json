      "source": "JON_HOPKINS.md",
      "prompt": "jon-hopkins",
      "style": "hopkins_journey",
      "motto": "Sketch quickly. Find the emotional seed. Transform it beyond the obvious. Commit. Build a world around it.",
      "tempo": { "range": [118, 130], "default": 126, "$assumption": "JON_HOPKINS.md gives no tempo; the range brackets his techno-derived work and the default sets the bar lengths of the blueprint timings." },
      "decision_hierarchy": ["emotion", "musical identity", "trajectory", "source character", "transformation", "rhythm", "space", "detail", "cleanliness", "loudness"],
      "poles": {
        "beauty": ["soft piano", "simple melodic cells", "suspended harmony", "open fifths", "slowly changing chords", "warm analogue-style tones", "environmental recordings", "wide reverberant space", "gentle high-frequency air", "slowly evolving pads", "long transitions", "imperfection"],
        "discomfort": ["saturation", "clipping", "crushed transients", "bit reduction", "resonant filtering", "unstable modulation", "dense feedback", "pitch deformation", "harsh upper-mid texture", "noise", "abrupt rhythmic pressure", "asymmetrical loops", "unexpected negative space"]
